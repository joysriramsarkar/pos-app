# =============================================================================
# Lakhan Bhandar POS — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# PostgreSQL (Supabase or local). Prisma runtime connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Direct (non-pooled) URL for migrations / prisma.config.ts seed.
# On Supabase this is often the "direct" connection string (port 5432).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# NextAuth — secret must be ≥ 32 characters
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Node environment (development | test | production)
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Comma-separated origins for CORS / CSRF allow-list (required in production)
# Example: http://localhost:3000,https://your-domain.com
ALLOWED_ORIGINS="http://localhost:3000"

# Admin password used by prisma seed (if unset, seed prints a random one-time password)
SEED_ADMIN_PASSWORD=""

# Upstash Redis — rate limiting (falls back to in-memory if unset)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Backup restore confirmation token (required for POST /api/backup restore)
RESTORE_CONFIRMATION_TOKEN=""

# Prisma pool size (serverless default is low)
# DATABASE_POOL_SIZE="3"

# Debug
# PRISMA_LOG="true"
# PRISMA_QUERY_LOG="true"
