// Lakhan Bhandar POS System - Multi-Tenant Database Schema
// Compatible with PostgreSQL (Neon / Cloudflare Hyperdrive)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Prisma 7: url ও directUrl এখন prisma.config.ts-এ configure করা হয়
  // দেখো: https://pris.ly/d/config-datasource
}


// ============================================================================
// MULTI-TENANT FOUNDATION
// ============================================================================

model Business {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique

  phone     String?
  email     String?
  address   String?

  currency  String  @default("INR")
  timezone  String  @default("Asia/Kolkata")

  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  memberships      Membership[]
  products         Product[]
  categories       Category[]
  customers        Customer[]
  suppliers        Supplier[]
  sales            Sale[]
  purchases        Purchase[]
  expenses         Expense[]
  stockHistory     StockHistory[]
  ledgerEntries    LedgerEntry[]
  saleReturns      SaleReturn[]
  auditLogs        AuditLog[]
  syncQueues       SyncQueue[]
  settings         BusinessSetting[]
  dailyRecords     DailyManualRecord[]
  productPopularity ProductPopularity[]

  @@map("businesses")
}

enum BusinessRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  VIEWER
}

model Membership {
  id         String       @id @default(cuid())

  userId     String       @map("user_id")
  businessId String       @map("business_id")

  role       BusinessRole @default(CASHIER)

  isActive   Boolean      @default(true) @map("is_active")

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@map("memberships")
}

model BusinessSetting {
  id         String  @id @default(cuid())

  businessId String  @map("business_id")
  key        String
  value      String

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@index([businessId])
  @@map("business_settings")
}

// ============================================================================
// PRODUCTS & INVENTORY
// ============================================================================

model Product {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  barcode       String?  // Nullable for non-barcoded items (vegetables, loose items)
  name          String
  nameBn        String?  @map("name_bn") // Bengali name
  category      String   @default("General")
  subCategory   String?  @default("") @map("sub_category") // sub-category for grouping products
  buyingPrice   Decimal  @default(0) @map("buying_price")
  sellingPrice  Decimal  @default(0) @map("selling_price")
  unit          String   @default("piece") // piece, kg, gram, liter, packet
  currentStock  Decimal  @default(0) @map("current_stock")
  minStockLevel Decimal  @default(5) @map("min_stock_level")
  isActive      Boolean  @default(true) @map("is_active") // Soft delete
  imageUrl      String?  @map("image_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleItems         SaleItem[]
  purchaseItems     PurchaseItem[]
  stockHistory      StockHistory[]
  productPopularity ProductPopularity[]

  @@unique([businessId, barcode]) // tenant-scoped barcode uniqueness
  @@index([businessId])
  @@index([businessId, isActive])
  @@index([businessId, category, isActive])
  @@index([businessId, category, isActive, name])
  @@index([businessId, name])
  @@map("products")
}

// Category catalog (lookup / backup). Product.category remains a denormalized
// string for POS speed; create/update product routes upsert matching Category rows.
model Category {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  name        String
  nameBn      String?  @map("name_bn")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name]) // tenant-scoped category name
  @@index([businessId])
  @@map("categories")
}

model StockHistory {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  productId    String   @map("product_id")
  changeType   String // "purchase", "sale", "adjustment", "return"
  quantity     Decimal // Positive for addition, negative for deduction
  reason       String?
  referenceId  String?     @map("reference_id") // Sale ID, Purchase ID, or Return ID
  saleId       String?     @map("sale_id")
  purchaseId   String?     @map("purchase_id")
  saleReturnId String?     @map("sale_return_id")
  createdAt    DateTime    @default(now()) @map("created_at")

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale       Sale?       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  purchase   Purchase?   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  saleReturn SaleReturn? @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, productId])
  @@index([createdAt])
  @@map("stock_history")
}

model ProductPopularity {
  id                String   @id @default(uuid())
  businessId        String   @map("business_id")
  productId         String   @map("product_id")
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  monthlySalesCount Int      @default(0) @map("monthly_sales_count")
  weeklySalesCount  Int      @default(0) @map("weekly_sales_count")
  totalRevenue      Decimal  @default(0) @db.Decimal(10, 2) @map("total_revenue")

  periodStart       DateTime @map("period_start")
  periodEnd         DateTime @map("period_end")

  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([productId, periodStart])
  @@index([businessId])
  @@index([businessId, monthlySalesCount])
  @@index([businessId, weeklySalesCount])
  @@map("product_popularity")
}

// ============================================================================
// CUSTOMERS & LEDGER (Due/Baki System)
// ============================================================================

model Customer {
  id             String   @id @default(cuid())
  businessId     String   @map("business_id")
  name           String
  nameEn         String?  @map("name_en")
  phone          String?
  address        String?
  totalDue       Decimal  @default(0) @map("total_due") // Running total of outstanding balance (owes store)
  totalPaid      Decimal  @default(0) @map("total_paid") // Total amount paid historically
  prepaidBalance Decimal  @default(0) @map("prepaid_balance") // Prepaid/credit balance (store owes customer)
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
  sales         Sale[]

  @@unique([businessId, phone]) // tenant-scoped phone uniqueness
  @@index([businessId])
  @@index([businessId, phone])
  @@map("customers")
}

model LedgerEntry {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  customerId   String   @map("customer_id")
  entryType    String // "credit" (customer owes more), "debit" (customer paid)
  amount       Decimal
  balanceAfter Decimal  @map("balance_after") // Balance after this transaction
  description  String?
  referenceId  String?  @map("reference_id") // Sale ID or Payment ID
  createdAt    DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, customerId])
  @@index([businessId, customerId, createdAt])
  @@index([businessId, customerId, entryType, createdAt])
  @@index([createdAt])
  @@map("ledger_entries")
}

// ============================================================================
// SALES & BILLING
// ============================================================================

model Sale {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  invoiceNumber String   @map("invoice_number")
  customerId    String?  @map("customer_id")
  userId        String?  @map("user_id") // Track which user created this sale
  subtotal      Decimal  @default(0)
  discount      Decimal  @default(0)
  tax           Decimal  @default(0)
  totalAmount   Decimal  @default(0) @map("total_amount")
  amountPaid    Decimal  @default(0) @map("amount_paid")
  paymentMethod String   @default("Cash") @map("payment_method") // Cash, UPI, Due
  paymentStatus String   @default("Paid") @map("payment_status") // Paid, Partial, Due
  status        String   @default("Completed") // Completed, Cancelled, Refunded, PartialReturn
  cashAmount    Decimal? @map("cash_amount")
  upiAmount     Decimal? @map("upi_amount")
  notes         String?
  offlineSynced Boolean  @default(true) @map("offline_synced") // For offline-first
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  business  Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer?    @relation(fields: [customerId], references: [id])
  user      User?        @relation(fields: [userId], references: [id])
  items     SaleItem[]
  returns   SaleReturn[]
  stockHistory StockHistory[]

  @@unique([businessId, invoiceNumber]) // tenant-scoped invoice number
  @@index([businessId])
  @@index([businessId, customerId])
  @@index([businessId, userId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, createdAt, status])
  @@map("sales")
}

model SaleItem {
  id              String   @id @default(cuid())
  saleId          String   @map("sale_id")
  productId       String   @map("product_id")
  productName     String   @map("product_name") // Snapshot at time of sale
  quantity        Decimal
  unitPrice       Decimal  @map("unit_price") // Selling price at time of sale
  costPriceAtSale Decimal  @default(0) @map("cost_price_at_sale") // WAC/cost snapshot for historical profit
  totalPrice      Decimal  @map("total_price")
  createdAt       DateTime @default(now()) @map("created_at")

  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id])
  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ============================================================================
// PARTIAL RETURNS
// ============================================================================

model SaleReturn {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  saleId       String   @map("sale_id")
  userId       String?  @map("user_id")
  refundAmount Decimal  @map("refund_amount")
  refundMethod String   @default("Cash") @map("refund_method") // Cash, Prepaid
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale         Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id])
  items        SaleReturnItem[]
  stockHistory StockHistory[]

  @@index([businessId])
  @@index([saleId])
  @@index([createdAt])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String   @id @default(cuid())
  saleReturnId String   @map("sale_return_id")
  saleItemId   String   @map("sale_item_id")
  productId    String   @map("product_id")
  productName  String   @map("product_name")
  quantity     Decimal
  unitPrice    Decimal  @map("unit_price")
  totalPrice   Decimal  @map("total_price")
  createdAt    DateTime @default(now()) @map("created_at")

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])

  @@index([saleReturnId])
  @@index([saleItemId])
  @@map("sale_return_items")
}

// ============================================================================
// PURCHASES (Restocking from Suppliers)
// ============================================================================

model Supplier {
  id        String   @id @default(cuid())
  businessId String  @map("business_id")
  name      String
  nameEn    String?  @map("name_en")
  phone     String?
  address   String?
  email     String?
  gstNumber String?  @map("gst_number")
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  expenses  Expense[]

  @@index([businessId])
  @@map("suppliers")
}

model Purchase {
  id             String   @id @default(cuid())
  businessId     String   @map("business_id")
  supplierId     String?  @map("supplier_id")
  invoiceNumber  String?  @map("invoice_number")
  totalAmount    Decimal  @default(0) @map("total_amount")
  paidAmount     Decimal  @default(0) @map("paid_amount")
  paymentStatus  String   @default("Pending") @map("payment_status") // Paid, Pending, Partial
  deliveryStatus String   @default("Pending") @map("delivery_status") // Pending, Ordered, PartiallyReceived, Received, Cancelled
  notes          String?
  paymentMethod  String   @default("Cash") @map("payment_method") // Cash, UPI, Bank, etc.
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
  items        PurchaseItem[]
  stockHistory StockHistory[]

  @@unique([businessId, invoiceNumber]) // tenant-scoped purchase invoice
  @@index([businessId])
  @@index([businessId, supplierId])
  @@index([createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String   @map("purchase_id")
  productId   String   @map("product_id")
  productName String   @map("product_name")
  quantity    Decimal
  receivedQty Decimal  @default(0) @map("received_qty")
  buyingPrice Decimal  @map("buying_price")
  totalPrice  Decimal  @map("total_price")
  createdAt   DateTime @default(now()) @map("created_at")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// ============================================================================
// SYNC QUEUE (Offline-First Architecture)
// ============================================================================

model SyncQueue {
  id             String    @id @default(cuid())
  businessId     String?   @map("business_id") // tenant context for sync verification
  userId         String?   @map("user_id")
  idempotencyKey String    @unique @map("idempotency_key") // UUID v4 - CRITICAL for preventing duplicates
  entityType     String    @map("entity_type") // sale:create, customer:update, etc.
  entityId       String?   @map("entity_id")
  action         String // sync action type
  payload        Json // JSON payload
  result         Json? // JSON result (for idempotency cache)
  synced         Boolean   @default(false)
  syncedAt       DateTime? @map("synced_at")
  retryCount     Int       @default(0) @map("retry_count")
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([synced])
  @@index([idempotencyKey])
  @@index([entityType])
  @@map("sync_queue")
}

// ============================================================================
// APP SETTINGS (kept for backward compat / system-level settings)
// ============================================================================

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id                     String    @id @default(cuid())
  username               String    @unique
  email                  String?   @unique
  passwordHash           String    @map("password_hash") // bcrypt hash — never plain text
  name                   String
  phone                  String?   @unique
  isActive               Boolean   @default(true) @map("is_active")
  requiresPasswordChange Boolean   @default(false) @map("requires_password_change")
  failedLoginAttempts    Int       @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime? @map("locked_until")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  // Relations
  memberships Membership[]
  sales       Sale[]
  saleReturns SaleReturn[]
  auditLogs   AuditLog[]

  @@map("users")
}

// ============================================================================
// ROLE PERMISSIONS (static role-based, used with BusinessRole)
// ============================================================================

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "users.create", "sales.view", "reports.export"
  description String?
  category    String // e.g., "users", "sales", "products", "reports", "settings"
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

// Define default role permissions
model RolePermission {
  id           String       @id @default(cuid())
  role         BusinessRole
  permissionId String       @map("permission_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

// ============================================================================
// EXPENSES
// ============================================================================

model Expense {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  amount        Decimal
  category      String
  notes         String?
  paymentMethod String   @default("Cash") @map("payment_method")
  date          DateTime @default(now())
  supplierId    String?  @map("supplier_id")
  supplierName  String?  @map("supplier_name")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([businessId])
  @@index([businessId, date])
  @@index([businessId, supplierId])
  @@map("expenses")
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  businessId String?  @map("business_id")
  userId     String?  @map("user_id")
  action     String // e.g., "CREATE_PRODUCT", "DELETE_SALE", "UPDATE_CUSTOMER", "LOGIN"
  entityType String // e.g., "Product", "Sale", "Customer", "User"
  entityId   String?  @map("entity_id")
  details    Json? // JSON details of the change
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// DAILY MANUAL CALCULATOR RECORDS
// ============================================================================

// Calendar-day key as yyyy-MM-dd string (timezone-stable daily buckets).
// Validated at API boundary via CalendarDateSchema — not a wall-clock DateTime.
model DailyManualRecord {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  date       String   // "yyyy-MM-dd"
  sales      Decimal  @default(0)
  expenses   Decimal  @default(0)
  profit     Decimal  @default(0)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date]) // tenant-scoped daily record
  @@index([businessId])
  @@map("daily_manual_records")
}
