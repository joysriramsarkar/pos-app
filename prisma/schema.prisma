// Lakhan Bhandar POS System - Multi-Tenant Database Schema
// Compatible with PostgreSQL (Neon / Cloudflare Hyperdrive)

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  // Prisma 7: url ও directUrl এখন prisma.config.ts-এ configure করা হয়
  // দেখো: https://pris.ly/d/config-datasource
}

// ============================================================================
// DOMAIN ENUMS — typed instead of raw strings (prevents typo-driven bugs)
// ============================================================================

enum PaymentStatus {
  PAID
  PARTIAL
  DUE
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
  PARTIAL_RETURN
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK
  CREDIT
  PREPAID
  MIXED
}

enum StockChangeType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  OPENING
}

enum PurchasePaymentStatus {
  PAID
  PENDING
  PARTIAL
}

enum PurchaseDeliveryStatus {
  PENDING
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum RefundMethod {
  CASH
  PREPAID
  UPI
  BANK
  CARD
  CREDIT
  ORIGINAL_METHOD
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum LedgerEntryType {
  CREDIT
  DEBIT
  PREPAYMENT_ADDED
  PREPAYMENT_USED
  PREPAYMENT_WITHDRAW
  PREPAYMENT_RESTORED
}

enum SupplierLedgerType {
  PURCHASE
  PAYMENT
  RETURN
  ADJUSTMENT
}

enum ExpensePaymentMethod {
  CASH
  UPI
  BANK
  CARD
  CHEQUE
  OTHER
}

// ============================================================================
// MULTI-TENANT FOUNDATION
// ============================================================================

model Business {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique

  phone     String?
  email     String?
  address   String?

  currency  String  @default("INR")
  timezone  String  @default("Asia/Kolkata")

  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  memberships      Membership[]
  products         Product[]
  categories       Category[]
  customers        Customer[]
  suppliers        Supplier[]
  sales            Sale[]
  purchases        Purchase[]
  expenses         Expense[]
  stockHistory     StockHistory[]
  ledgerEntries    LedgerEntry[]
  supplierLedger   SupplierLedgerEntry[]
  saleReturns      SaleReturn[]
  auditLogs        AuditLog[]
  syncQueues       SyncQueue[]
  settings         BusinessSetting[]
  dailyRecords     DailyManualRecord[]
  productPopularity ProductPopularity[]
  cashRegisterShifts CashRegisterShift[]

  @@map("businesses")
}

enum BusinessRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  VIEWER
}

model Membership {
  id         String       @id @default(cuid())

  userId     String       @map("user_id")
  businessId String       @map("business_id")

  role       BusinessRole @default(CASHIER)

  isActive   Boolean      @default(true) @map("is_active")

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@map("memberships")
}

model BusinessSetting {
  id         String  @id @default(cuid())

  businessId String  @map("business_id")
  key        String
  value      String

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@index([businessId])
  @@map("business_settings")
}

// ============================================================================
// PRODUCTS & INVENTORY
// ============================================================================

model Product {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  barcode       String?  // Nullable for non-barcoded items (vegetables, loose items)
  name          String
  nameBn        String?  @map("name_bn") // Bengali name
  category      String   @default("General")
  subCategory   String?  @default("") @map("sub_category") // sub-category for grouping products
  buyingPrice   Decimal  @default(0) @map("buying_price")
  sellingPrice  Decimal  @default(0) @map("selling_price")
  unit          String   @default("piece") // piece, kg, gram, liter, packet
  currentStock  Decimal  @default(0) @map("current_stock")
  minStockLevel Decimal  @default(5) @map("min_stock_level")
  isActive      Boolean  @default(true) @map("is_active") // Soft delete
  imageUrl      String?  @map("image_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleItems         SaleItem[]
  purchaseItems     PurchaseItem[]
  stockHistory      StockHistory[]
  productPopularity ProductPopularity[]

  @@unique([businessId, barcode]) // tenant-scoped barcode uniqueness
  @@index([businessId])
  @@index([businessId, isActive])
  @@index([businessId, category, isActive])
  @@index([businessId, category, isActive, name])
  @@index([businessId, name])
  @@map("products")
}

// Category catalog (lookup / backup). Product.category remains a denormalized
// string for POS speed; create/update product routes upsert matching Category rows.
model Category {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  name        String
  nameBn      String?  @map("name_bn")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name]) // tenant-scoped category name
  @@index([businessId])
  @@map("categories")
}

model StockHistory {
  id           String          @id @default(cuid())
  businessId   String          @map("business_id")
  productId    String          @map("product_id")
  changeType   StockChangeType // PURCHASE, SALE, ADJUSTMENT, RETURN, etc.
  quantity     Decimal // Positive for addition, negative for deduction
  reason       String?
  referenceId  String?     @map("reference_id") // Sale ID, Purchase ID, or Return ID
  saleId       String?     @map("sale_id")
  purchaseId   String?     @map("purchase_id")
  saleReturnId String?     @map("sale_return_id")
  userId       String?     @map("user_id") // Who made the change (for adjustments)
  createdAt    DateTime    @default(now()) @map("created_at")

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale       Sale?       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  purchase   Purchase?   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  saleReturn SaleReturn? @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, productId])
  @@index([businessId, productId, createdAt])
  @@index([createdAt])
  @@map("stock_history")
}

model ProductPopularity {
  id                String   @id @default(uuid())
  businessId        String   @map("business_id")
  productId         String   @map("product_id")
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  monthlySalesCount Int      @default(0) @map("monthly_sales_count")
  weeklySalesCount  Int      @default(0) @map("weekly_sales_count")
  totalRevenue      Decimal  @default(0) @db.Decimal(10, 2) @map("total_revenue")

  periodStart       DateTime @map("period_start")
  periodEnd         DateTime @map("period_end")

  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([productId, periodStart])
  @@index([businessId])
  @@index([businessId, monthlySalesCount])
  @@index([businessId, weeklySalesCount])
  @@map("product_popularity")
}

// ============================================================================
// CUSTOMERS & LEDGER (Due/Baki System)
// ============================================================================

model Customer {
  id             String   @id @default(cuid())
  businessId     String   @map("business_id")
  name           String
  nameEn         String?  @map("name_en")
  phone          String?
  address        String?
  totalDue       Decimal  @default(0) @map("total_due") // Running total of outstanding balance (owes store)
  totalPaid      Decimal  @default(0) @map("total_paid") // Total amount paid historically
  prepaidBalance Decimal  @default(0) @map("prepaid_balance") // Prepaid/credit balance (store owes customer)
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
  sales         Sale[]

  @@unique([businessId, phone]) // tenant-scoped phone uniqueness
  @@index([businessId])
  @@index([businessId, phone])
  @@map("customers")
}

model LedgerEntry {
  id           String           @id @default(cuid())
  businessId   String           @map("business_id")
  customerId   String           @map("customer_id")
  entryType    LedgerEntryType // CREDIT (customer owes more), DEBIT (customer paid)
  amount       Decimal
  balanceAfter Decimal          @map("balance_after") // Balance after this transaction
  description  String?
  referenceId  String?          @map("reference_id") // Sale ID or Payment ID
  createdAt    DateTime         @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, customerId])
  @@index([businessId, customerId, createdAt])
  @@index([businessId, customerId, entryType, createdAt])
  @@index([createdAt])
  @@map("ledger_entries")
}

// ============================================================================
// SALES & BILLING
// ============================================================================

model Sale {
  id            String        @id @default(cuid())
  businessId    String        @map("business_id")
  invoiceNumber String        @map("invoice_number")
  customerId    String?       @map("customer_id")
  userId        String?       @map("user_id") // Track which user created this sale
  shiftId       String?       @map("shift_id") // Cash register shift
  subtotal      Decimal       @default(0)
  discount      Decimal       @default(0)
  discountType  DiscountType  @default(FIXED) @map("discount_type")
  tax           Decimal       @default(0)
  totalAmount   Decimal       @default(0) @map("total_amount")
  amountPaid    Decimal       @default(0) @map("amount_paid")
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus PaymentStatus @default(PAID) @map("payment_status")
  status        SaleStatus    @default(COMPLETED)
  cashAmount    Decimal?      @map("cash_amount")
  upiAmount     Decimal?      @map("upi_amount")
  notes         String?
  offlineSynced Boolean       @default(true) @map("offline_synced") // For offline-first
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer?         @relation(fields: [customerId], references: [id])
  user         User?             @relation(fields: [userId], references: [id])
  shift        CashRegisterShift? @relation(fields: [shiftId], references: [id])
  items        SaleItem[]
  returns      SaleReturn[]
  stockHistory StockHistory[]
  payments     Payment[]

  @@unique([businessId, invoiceNumber]) // tenant-scoped invoice number
  @@index([businessId])
  @@index([businessId, customerId])
  @@index([businessId, userId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, createdAt, status])
  @@map("sales")
}

model SaleItem {
  id              String       @id @default(cuid())
  saleId          String       @map("sale_id")
  productId       String       @map("product_id")
  productName     String       @map("product_name") // Snapshot at time of sale
  quantity        Decimal
  unitPrice       Decimal      @map("unit_price") // Selling price at time of sale
  costPriceAtSale Decimal      @default(0) @map("cost_price_at_sale") // WAC/cost snapshot for historical profit
  discount        Decimal      @default(0) // Per-item discount amount
  discountType    DiscountType @default(FIXED) @map("discount_type")
  totalPrice      Decimal      @map("total_price") // After item-level discount
  taxRate         Decimal      @default(0) @map("tax_rate") // Tax rate applied
  taxAmount       Decimal      @default(0) @map("tax_amount")
  createdAt       DateTime     @default(now()) @map("created_at")

  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id])
  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// Separate Payment records for split-payment support and reconciliation
model Payment {
  id            String        @id @default(cuid())
  saleId        String        @map("sale_id")
  businessId    String        @map("business_id")
  method        PaymentMethod
  amount        Decimal
  referenceNo   String?       @map("reference_no") // UPI transaction ID, card ref, etc.
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")

  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([businessId])
  @@index([businessId, method])
  @@map("payments")
}

// ============================================================================
// PARTIAL RETURNS
// ============================================================================

model SaleReturn {
  id           String       @id @default(cuid())
  businessId   String       @map("business_id")
  saleId       String       @map("sale_id")
  userId       String?      @map("user_id")
  refundAmount Decimal      @map("refund_amount")
  refundMethod RefundMethod @default(CASH) @map("refund_method")
  reason       String?
  createdAt    DateTime     @default(now()) @map("created_at")

  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale         Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id])
  items        SaleReturnItem[]
  stockHistory StockHistory[]

  @@index([businessId])
  @@index([saleId])
  @@index([createdAt])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String   @id @default(cuid())
  saleReturnId String   @map("sale_return_id")
  saleItemId   String   @map("sale_item_id")
  productId    String   @map("product_id")
  productName  String   @map("product_name")
  quantity     Decimal
  unitPrice    Decimal  @map("unit_price")
  totalPrice   Decimal  @map("total_price")
  createdAt    DateTime @default(now()) @map("created_at")

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])

  @@index([saleReturnId])
  @@index([saleItemId])
  @@map("sale_return_items")
}

// ============================================================================
// PURCHASES (Restocking from Suppliers)
// ============================================================================

model Supplier {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  name       String
  nameEn     String?  @map("name_en")
  phone      String?
  address    String?
  email      String?
  gstNumber  String?  @map("gst_number")
  notes      String?
  totalDue   Decimal  @default(0) @map("total_due") // Amount owed to supplier
  totalPaid  Decimal  @default(0) @map("total_paid") // Total paid historically
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases      Purchase[]
  expenses       Expense[]
  ledgerEntries  SupplierLedgerEntry[]

  @@index([businessId])
  @@map("suppliers")
}

// Supplier Ledger — mirrors customer LedgerEntry for symmetric payable tracking
model SupplierLedgerEntry {
  id           String             @id @default(cuid())
  businessId   String             @map("business_id")
  supplierId   String             @map("supplier_id")
  entryType    SupplierLedgerType
  amount       Decimal
  balanceAfter Decimal            @map("balance_after")
  description  String?
  referenceId  String?            @map("reference_id") // Purchase ID or Payment ID
  createdAt    DateTime           @default(now()) @map("created_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, supplierId])
  @@index([businessId, supplierId, createdAt])
  @@map("supplier_ledger_entries")
}

model Purchase {
  id             String                 @id @default(cuid())
  businessId     String                 @map("business_id")
  supplierId     String?                @map("supplier_id")
  invoiceNumber  String?                @map("invoice_number")
  totalAmount    Decimal                @default(0) @map("total_amount")
  paidAmount     Decimal                @default(0) @map("paid_amount")
  paymentStatus  PurchasePaymentStatus  @default(PENDING) @map("payment_status")
  deliveryStatus PurchaseDeliveryStatus @default(PENDING) @map("delivery_status")
  notes          String?
  paymentMethod  PaymentMethod          @default(CASH) @map("payment_method")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
  items        PurchaseItem[]
  stockHistory StockHistory[]

  @@unique([businessId, invoiceNumber]) // tenant-scoped purchase invoice
  @@index([businessId])
  @@index([businessId, supplierId])
  @@index([createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String   @map("purchase_id")
  productId   String   @map("product_id")
  productName String   @map("product_name")
  quantity    Decimal
  receivedQty Decimal  @default(0) @map("received_qty")
  buyingPrice Decimal  @map("buying_price")
  totalPrice  Decimal  @map("total_price")
  createdAt   DateTime @default(now()) @map("created_at")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// ============================================================================
// SYNC QUEUE (Offline-First Architecture)
// ============================================================================

model SyncQueue {
  id             String    @id @default(cuid())
  businessId     String?   @map("business_id") // tenant context for sync verification
  userId         String?   @map("user_id")
  idempotencyKey String    @unique @map("idempotency_key") // UUID v4 - CRITICAL for preventing duplicates
  entityType     String    @map("entity_type") // sale:create, customer:update, etc.
  entityId       String?   @map("entity_id")
  action         String // sync action type
  payload        Json // JSON payload
  result         Json? // JSON result (for idempotency cache)
  synced         Boolean   @default(false)
  syncedAt       DateTime? @map("synced_at")
  retryCount     Int       @default(0) @map("retry_count")
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([synced])
  @@index([idempotencyKey])
  @@index([entityType])
  @@map("sync_queue")
}

// ============================================================================
// APP SETTINGS (kept for backward compat / system-level settings)
// ============================================================================

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id                     String    @id @default(cuid())
  username               String    @unique
  email                  String?   @unique
  passwordHash           String    @map("password_hash") // bcrypt hash — never plain text
  name                   String
  phone                  String?   @unique
  isActive               Boolean   @default(true) @map("is_active")
  requiresPasswordChange Boolean   @default(false) @map("requires_password_change")
  failedLoginAttempts    Int       @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime? @map("locked_until")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  // Relations
  memberships        Membership[]
  sales              Sale[]
  saleReturns        SaleReturn[]
  auditLogs          AuditLog[]
  cashRegisterShifts CashRegisterShift[]

  @@map("users")
}

// ============================================================================
// ROLE PERMISSIONS (static role-based, used with BusinessRole)
// ============================================================================

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "users.create", "sales.view", "reports.export"
  description String?
  category    String // e.g., "users", "sales", "products", "reports", "settings"
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

// Define default role permissions
model RolePermission {
  id           String       @id @default(cuid())
  role         BusinessRole
  permissionId String       @map("permission_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

// ============================================================================
// EXPENSES
// ============================================================================

model Expense {
  id            String               @id @default(cuid())
  businessId    String               @map("business_id")
  amount        Decimal
  category      String
  notes         String?
  paymentMethod ExpensePaymentMethod @default(CASH) @map("payment_method")
  date          DateTime             @default(now())
  supplierId    String?              @map("supplier_id")
  supplierName  String?              @map("supplier_name")
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([businessId])
  @@index([businessId, date])
  @@index([businessId, supplierId])
  @@map("expenses")
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  businessId String?  @map("business_id")
  userId     String?  @map("user_id")
  action     String // e.g., "CREATE_PRODUCT", "DELETE_SALE", "UPDATE_CUSTOMER", "LOGIN"
  entityType String // e.g., "Product", "Sale", "Customer", "User"
  entityId   String?  @map("entity_id")
  details    Json? // JSON details of the change
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// DAILY MANUAL CALCULATOR RECORDS
// ============================================================================

// Calendar-day key as yyyy-MM-dd string (timezone-stable daily buckets).
// Validated at API boundary via CalendarDateSchema — not a wall-clock DateTime.
model DailyManualRecord {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  date       String   // "yyyy-MM-dd"
  sales      Decimal  @default(0)
  expenses   Decimal  @default(0)
  profit     Decimal  @default(0)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date]) // tenant-scoped daily record
  @@index([businessId])
  @@map("daily_manual_records")
}

// ============================================================================
// CASH REGISTER & SHIFT MANAGEMENT
// ============================================================================

model CashRegisterShift {
  id             String    @id @default(cuid())
  businessId     String    @map("business_id")
  userId         String    @map("user_id") // Cashier who opened the shift
  shiftNumber    Int       @map("shift_number") // Auto-increment per business
  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")
  openingCash    Decimal   @default(0) @map("opening_cash")
  closingCash    Decimal?  @map("closing_cash") // Actual cash counted at end
  expectedCash   Decimal?  @map("expected_cash") // Calculated expected cash
  cashDifference Decimal?  @map("cash_difference") // closingCash - expectedCash
  totalSales     Decimal   @default(0) @map("total_sales")
  totalExpenses  Decimal   @default(0) @map("total_expenses")
  totalRefunds   Decimal   @default(0) @map("total_refunds")
  notes          String?
  isActive       Boolean   @default(true) @map("is_active") // true = shift is open

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
  sales    Sale[]

  @@unique([businessId, shiftNumber])
  @@index([businessId])
  @@index([businessId, userId])
  @@index([businessId, isActive])
  @@map("cash_register_shifts")
}

// ============================================================================
// TAX CATEGORIES (GST-ready)
// ============================================================================

model TaxCategory {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  name       String   // e.g., "GST 5%", "GST 12%", "GST 18%", "Exempt"
  rate       Decimal  // Percentage (e.g., 5, 12, 18, 0)
  cgst       Decimal  @default(0) // CGST component
  sgst       Decimal  @default(0) // SGST component
  igst       Decimal  @default(0) // IGST (interstate)
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([businessId, name])
  @@index([businessId])
  @@map("tax_categories")
}
