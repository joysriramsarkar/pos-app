{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pos-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": false
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cloudflare Hyperdrive — Neon DB connection pool প্রক্সি
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "93a58f1dbd244c3d93ad71ca450204d5",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
    }
  ],
  "vars": {
    "NEXTAUTH_URL": "https://pos.onuron.org",
    "ALLOWED_ORIGINS": "https://pos.onuron.org,https://pos-app.joysriram-sarkar-56.workers.dev,http://localhost:3000"
  },
  "observability": {
    "enabled": true
  }
}
